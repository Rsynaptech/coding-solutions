#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        string s;
        cin >> n >> s;
        int x = 0, y = 0;
        for (char c : s) {
            if (c == 'U') y++;
            else if (c == 'D') y--;
            else if (c == 'L') x--;
            else if (c == 'R') x++;
        }
        if ((x == 0 && (y == 2 || y == -2)) || (y == 0 && (x == 2 || x == -2)))
            cout << "YES\n";
        else
            cout << "NO\n";
    }
    return 0;
}
