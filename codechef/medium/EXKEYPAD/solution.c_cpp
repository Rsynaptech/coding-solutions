#include <bits/stdc++.h>
using namespace std;

int main() {
int T;
cin >> T;

```
while (T--) {
    long long N;
    int D;
    cin >> N >> D;

    string s = to_string(N);

    if (D == 0) {
        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '0') {
                s[i] = '1';
                for (int j = i + 1; j < s.size(); j++) {
                    s[j] = '1';
                }
                break;
            }
        }

        cout << stoll(s) << endl;
        continue;
    }

    for (int i = 0; i < s.size(); i++) {
        if (s[i] == '0' + D) {
            if (i == 0) {
                if (D == 9) {
                    s = string(s.size() + 1, '1');
                } else {
                    s[i] = '0' + D + 1;
                    for (int j = i + 1; j < s.size(); j++) {
                        s[j] = '0';
                    }
                }
            } else {
                int j = i - 1;

                while (j >= 0 && s[j] == '0' + D - 1) {
                    j--;
                }

                if (j < 0) {
                    s = string(s.size() + 1, '1');
                } else {
                    s[j]++;
                    for (int k = j + 1; k < s.size(); k++) {
                        s[k] = '0';
                    }
                }
            }
            break;
        }
    }

    cout << stoll(s) << endl;
}

return 0;
```

}

