
#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        string S;
        cin >> S;

        int ans = 0;
        int last = -1;

        for (int i = 0; i < N; i++) {
            if (S[i] == '1' && i > last) {
                ans++;
                last = i + K;
            }
        }

        cout << ans << endl;
    }

    return 0;
}