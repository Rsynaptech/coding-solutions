#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string S;
        cin >> N >> S;

        int count = 0;
        bool hard = false;

        for (int i = 0; i < N; i++) {

            if (S[i] == 'a' || S[i] == 'e' || 
                S[i] == 'i' || S[i] == 'o' || 
                S[i] == 'u') {
                
                count = 0;
            }
            else {
                count++;

                if (count >= 4) {
                    hard = true;
                    break;
                }
            }
        }

        if (hard)
            cout << "NO" << endl;
        else
            cout << "YES" << endl;
    }

    return 0;
}