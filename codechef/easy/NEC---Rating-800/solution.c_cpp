#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int n, k;
        cin >> n >> k;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        // Left rotation by k positions
        for (int i = k; i < n; i++) {
            cout << a[i] << " ";
        }

        for (int i = 0; i < k; i++) {
            cout << a[i] << " ";
        }

        cout << endl;
    }

    return 0;
}